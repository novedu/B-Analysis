{
  "manifest_version": 3,
  "name": "B站数据导出器",
  "version": "0.2.0",
  "description": "导出你自己的 B 站观看历史、关注、收藏与稍后再看。只读采集，数据只存在你的电脑上。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["*://*.bilibili.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["src/collector.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "B站数据导出器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
